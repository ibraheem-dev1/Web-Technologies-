<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Orders</title>
    <link rel="stylesheet" href="/index.css">
</head>
<body>
    <div class="admin_layout">
        <%- include('partials/sidebar', { user: user }) %>
        <main class="admin_content">
            <div class="admin_header">
                <h1>Orders</h1>
            </div>

            <%- include('partials/flash') %>

            <div class="admin_table_wrap">
                <table class="admin_table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders.length === 0) { %>
                            <tr>
                                <td colspan="6">No orders yet.</td>
                            </tr>
                        <% } %>
                        <% orders.forEach(function(order) { %>
                            <tr>
                                <td>#<%= String(order._id).slice(-6) %></td>
                                <td>
                                    <div><%= order.user && order.user.name ? order.user.name : 'Customer' %></div>
                                    <div class="admin_muted"><%= order.user && order.user.email ? order.user.email : '' %></div>
                                </td>
                                <td><%= order.totalQty %></td>
                                <td>Rs. <%= order.totalAmount %></td>
                                <td>
                                    <form class="order_status_form" method="POST" action="/admin/orders/<%= order._id %>/status">
                                        <select name="status" class="admin_select">
                                            <% statusOptions.forEach(function(status) { %>
                                                <option value="<%= status %>" <%= order.status === status ? 'selected' : '' %>>
                                                    <%= status.charAt(0).toUpperCase() + status.slice(1) %>
                                                </option>
                                            <% }); %>
                                        </select>
                                        <button class="admin_link" type="submit">Update</button>
                                    </form>
                                </td>
                                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</body>
</html>
