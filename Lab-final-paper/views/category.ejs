<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= categoryName %> – Myntra</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
    <link rel="stylesheet" href="/index.css">
    <style>
        .cat_banner {
            background: linear-gradient(135deg, #ff3f6c 0%, #ff7043 100%);
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 80px;
        }
        .cat_banner h1 {
            color: #fff;
            font-size: 3rem;
            font-weight: 900;
            letter-spacing: .15em;
            text-transform: uppercase;
        }
        /* override main margin-top for category pages since banner handles spacing */
        main { margin-top: 0 !important; }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <main>
        <!-- Category Banner -->
        <div class="cat_banner">
            <h1><%= categoryName %></h1>
        </div>

        <!-- Product Grid -->
        <div class="category_heading">SHOP <%= categoryName.toUpperCase() %></div>
        <div class="product_grid">
            <% products.forEach(function(p) { %>
                <%- include('partials/product_card', { p: p }) %>
            <% }); %>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    <script src="/index.js"></script>
</body>
</html>
