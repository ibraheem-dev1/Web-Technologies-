<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart - Myntra</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="/index.css">
</head>
<body>

    <%- include('partials/header') %>

    <main class="cart_page">
        <div class="cart_card">
            <div class="cart_header">
                <div>
                    <h1>Shopping Cart</h1>
                    <p><%= totalQty %> items</p>
                </div>
                <a class="outline_btn" href="/products">Continue Shopping</a>
            </div>

            <% if (items.length === 0) { %>
                <div class="cart_empty">
                    <p>Your cart is empty.</p>
                    <a class="auth_btn" href="/products">Browse Products</a>
                </div>
            <% } else { %>
                <div class="cart_list">
                    <% items.forEach(function(item) { %>
                        <div class="cart_item">
                            <img class="cart_item_img" src="<%= item.imageUrl %>" alt="<%= item.name %>">
                            <div class="cart_item_info">
                                <h3><%= item.name %></h3>
                                <div class="cart_item_meta">In stock: <%= item.stock %></div>
                            </div>
                            <form class="cart_qty_form" method="POST" action="/cart/adjust" data-price="<%= item.price %>">
                                <input type="hidden" name="productId" value="<%= item.productId %>">
                                <div class="qty_control">
                                    <button class="qty_btn" name="delta" value="-1" type="submit" data-delta="-1">-</button>
                                    <input class="qty_input" type="number" value="<%= item.qty %>" readonly>
                                    <button class="qty_btn" name="delta" value="1" type="submit" data-delta="1" <%= item.stock > 0 && item.qty >= item.stock ? 'disabled' : '' %>>+</button>
                                </div>
                            </form>
                            <div class="cart_item_price" data-line-total>Rs. <%= item.price * item.qty %></div>
                            <form class="cart_remove_form" method="POST" action="/cart/remove">
                                <input type="hidden" name="productId" value="<%= item.productId %>">
                                <button class="cart_remove_btn" type="submit">Remove</button>
                            </form>
                        </div>
                    <% }); %>
                </div>

                <div class="cart_summary">
                    <span>Total</span>
                    <strong data-cart-total>Rs. <%= total %></strong>
                </div>

                <div class="cart_actions">
                    <a class="auth_btn" href="/checkout">Proceed to Checkout</a>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>

</body>
</html>
