<div class="product_card">
    <% const imageSrc = p.imageUrl ? p.imageUrl : '/images/banner.jpg'; %>
    <% const outOfStock = !p.stock || p.stock <= 0; %>
    <div class="product_image">
        <img src="<%= imageSrc %>" alt="<%= p.name %>">
        <% if (outOfStock) { %>
            <span class="stock_badge">Out of stock</span>
        <% } %>
    </div>
    <div class="product_info">
        <h3 class="product_brand"><%= p.brand %></h3>
        <p class="product_name"><%= p.name %></p>

        <div class="product_rating">
            <span class="rating_badge">★ <%= p.rating %></span>
            <span class="rating_count">| <%= p.ratingCount %></span>
        </div>

        <div class="product_price">
            <span class="price">Rs. <%= p.price %></span>
            <span class="mrp">Rs. <%= p.mrp %></span>
            <span class="discount">(<%= p.discount %>% OFF)</span>
        </div>

        <form class="add_to_cart_form" method="POST" action="/cart/add">
            <input type="hidden" name="productId" value="<%= p._id %>">
            <div class="qty_control">
                <button class="qty_btn" type="button" data-action="decrease" <%= outOfStock ? 'disabled' : '' %>>-</button>
                <input class="qty_input" type="number" name="qty" min="1" value="1" <%= p.stock ? 'max="' + p.stock + '"' : '' %> <%= outOfStock ? 'disabled' : '' %>>
                <button class="qty_btn" type="button" data-action="increase" <%= outOfStock ? 'disabled' : '' %>>+</button>
            </div>
            <button class="add_to_cart" type="submit" <%= outOfStock ? 'disabled' : '' %>>
                <%= outOfStock ? 'OUT OF STOCK' : 'ADD TO CART' %>
            </button>
        </form>
    </div>
</div>
