<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Myntra Clone</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
    <link rel="stylesheet" href="/index.css">
</head>
<body>

    <%- include('partials/header') %>

    <main>
        <div class="banner_container">
            <img class="banner_image" src="/images/banner.jpg" alt="Main Banner">
        </div>

        <div class="category_heading">MEDAL WORTHY BRANDS TO BAG</div>

        <div class="slider_wrapper" style="position: relative; max-width: 90%; margin: 0 auto; padding: 0 40px;">
            <button id="slider_prev" class="slider_btn prev_side">&#10094;</button>

            <div class="slider_container" id="offers_slider">
                <% offerImages.forEach(function(n) { %>
                    <a href="#"><img class="sale_item" src="/images/offers/<%= n %>.png" alt="Offer <%= n %>"></a>
                <% }); %>
            </div>

            <button id="slider_next" class="slider_btn next_side">&#10095;</button>

            <div class="slider_controls">
                <span id="slide_counter" class="slide_counter">Showing 1 of <%= offerImages.length %></span>
            </div>
        </div>

        <div class="category_heading">SHOP BY CATEGORY</div>
        <div class="product_grid">
            <% products.forEach(function(p) { %>
                <%- include('partials/product_card', { p: p }) %>
            <% }); %>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    <script src="/index.js"></script>
</body>
</html>
