<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details - Myntra</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="/index.css">
</head>
<body>

    <%- include('partials/header') %>

    <main class="orders_page">
        <div class="orders_card">
            <div class="orders_header">
                <h1>Order #<%= String(order._id).slice(-6) %></h1>
                <a class="outline_btn" href="/orders">Back to Orders</a>
            </div>

            <div class="order_detail_meta">
                <div>
                    <span>Status</span>
                    <strong><%= order.status %></strong>
                </div>
                <div>
                    <span>Total</span>
                    <strong>Rs. <%= order.totalAmount %></strong>
                </div>
                <div>
                    <span>Date</span>
                    <strong><%= new Date(order.createdAt).toLocaleString() %></strong>
                </div>
            </div>

            <div class="order_address">
                <h2>Shipping Address</h2>
                <p><%= order.address.name %></p>
                <p><%= order.address.street %>, <%= order.address.city %></p>
                <p><%= order.address.postal %>, <%= order.address.country %></p>
                <p>Phone: <%= order.address.phone %></p>
            </div>

            <div class="order_items">
                <% order.items.forEach(function(item) { %>
                    <div class="order_item">
                        <img src="<%= item.imageUrl %>" alt="<%= item.name %>">
                        <div>
                            <h3><%= item.name %></h3>
                            <div class="order_item_meta">Qty: <%= item.qty %></div>
                        </div>
                        <div class="order_item_price">Rs. <%= item.price * item.qty %></div>
                    </div>
                <% }); %>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

</body>
</html>
