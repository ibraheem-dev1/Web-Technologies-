<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - Myntra</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="/index.css">
</head>
<body>

    <%- include('partials/header') %>

    <main class="checkout_page">
        <div class="checkout_card checkout_wide">
            <h1>Checkout</h1>
            <p>Review your order before placing it.</p>
            <form class="checkout_form" method="POST" action="/checkout">
                <div class="checkout_grid">
                    <div class="checkout_section">
                        <h2>Shipping Address</h2>
                        <label class="auth_label" for="name">Full Name</label>
                        <input class="auth_input" id="name" name="name" type="text" value="<%= address.name || '' %>" required>

                        <label class="auth_label" for="phone">Phone</label>
                        <input class="auth_input" id="phone" name="phone" type="text" value="<%= address.phone || '' %>" required>

                        <label class="auth_label" for="street">Street Address</label>
                        <input class="auth_input" id="street" name="street" type="text" value="<%= address.street || '' %>" required>

                        <label class="auth_label" for="city">City</label>
                        <input class="auth_input" id="city" name="city" type="text" value="<%= address.city || '' %>" required>

                        <label class="auth_label" for="postal">Postal Code</label>
                        <input class="auth_input" id="postal" name="postal" type="text" value="<%= address.postal || '' %>" required>

                        <label class="auth_label" for="country">Country</label>
                        <input class="auth_input" id="country" name="country" type="text" value="<%= address.country || '' %>" required>
                    </div>

                    <div class="checkout_section">
                        <h2>Order Summary</h2>
                        <div class="checkout_list">
                            <% items.forEach(function(item) { %>
                                <div class="checkout_item">
                                    <img src="<%= item.imageUrl %>" alt="<%= item.name %>">
                                    <div>
                                        <h3><%= item.name %></h3>
                                        <div class="checkout_meta">Qty: <%= item.qty %></div>
                                    </div>
                                    <div class="checkout_price">Rs. <%= item.price * item.qty %></div>
                                </div>
                            <% }); %>
                        </div>

                        <div class="checkout_total">
                            <span>Total</span>
                            <strong>Rs. <%= total %></strong>
                        </div>
                    </div>
                </div>

                <div class="checkout_actions">
                    <a class="outline_btn" href="/cart">Back to Cart</a>
                    <button class="profile_btn" type="submit">Place Order</button>
                </div>
            </form>
        </div>
    </main>

    <%- include('partials/footer') %>

</body>
</html>
